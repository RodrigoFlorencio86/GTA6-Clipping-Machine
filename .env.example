# Copy to .env and adjust. Every variable is optional.
# This project needs no accounts, tokens or keys of any kind.

# Where videos, the vector index, previews, clips and the SQLite database live.
# GCM_DATA_DIR=./data

# Folder with processing.yaml, models.yaml and tags.yaml.
# GCM_CONFIG_DIR=./configs

# Hugging Face model id, or a local folder containing the EmbeddingGemma 2 weights.
# GCM_EMBEDDING_MODEL=google/embeddinggemma-2

# auto | cuda | mps | cpu
# GCM_DEVICE=auto

# Set to 1 after the model has been downloaded once: blocks all network access.
# GCM_OFFLINE=0

# Interface language: en | pt
# GCM_LANG=en

# Only if FFmpeg is not on PATH.
# GCM_FFMPEG=/path/to/ffmpeg
# GCM_FFPROBE=/path/to/ffprobe
